# Maintainer: Your Name <you@example.com>
pkgname=zplinux
pkgver=0.5.0
pkgrel=1
pkgdesc="Label designer for Zebra and other ZPL thermal printers (GTK3)"
arch=('any')
url="https://github.com/thuutien/ZPLinux"
license=('GPL-3.0-only')
depends=('python' 'python-gobject' 'python-cairo' 'gtk3' 'pango')
conflicts=('labelix')
replaces=('labelix')
optdepends=('python-qrcode: draw QR codes in the preview'
            'zint: preview the barcode types other than Code 128 and QR'
            'ttf-liberation: closest match to the printer font in the preview'
            'cups: print through a raw CUPS queue'
            'polkit: install updates from inside the app')
source=("$pkgname-$pkgver.tar.gz::https://github.com/thuutien/ZPLinux/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('8d70b089285dfad1c461aac90218a89a0e0245a634093140615b171697c1a516')

package() {
  cd "$pkgname-$pkgver"
  sh install.sh --prefix-root "$pkgdir"
}
